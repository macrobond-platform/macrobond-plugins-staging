{
  "tools": [
    {
      "name": "fetch_all_vintages",
      "title": "Fetch all vintages",
      "description": "Fetch the complete revision history for a single series.\n\nIf unsure of Macrobond's usage rules, call get_instructions() first.\n\nCall with confirm=false first to preview (fetches nothing); after the user's\nexplicit confirmation, re-call with confirm=true and the returned invocation_token.\n\nResults are paginated over the vintages: `limit` per page (default 20),\nselected by `page` (1-based). Read `total_pages` / `has_next`. Pages after\nthe first are served from the cached result — no new confirmation or quota cost.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Series name."
          },
          "confirm": {
            "default": false,
            "type": "boolean",
            "description": "False (default) returns a preview without fetching. True performs the fetch."
          },
          "invocation_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required when confirm=true. Must match the token returned by the preview call."
          },
          "if_modified_since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only return data if modified since this ISO timestamp."
          },
          "last_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "For incremental updates — LastRevisionTimeStamp from prior response."
          },
          "last_revision_adjustment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "For incremental updates — LastRevisionAdjustmentTimeStamp from prior response."
          },
          "date_end_of_period": {
            "default": false,
            "type": "boolean",
            "description": "Return dates at end of period instead of start."
          },
          "limit": {
            "default": 20,
            "minimum": 1,
            "type": "integer",
            "description": "Vintages per page (min 1, default 20)."
          },
          "page": {
            "default": 1,
            "minimum": 1,
            "type": "integer",
            "description": "1-based page number over the fetched vintages."
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
    },
    {
      "name": "fetch_entities",
