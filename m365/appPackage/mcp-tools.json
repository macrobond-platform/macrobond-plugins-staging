      "inputSchema": {
        "type": "object",
        "properties": {
          "names": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "description": "Entity names to fetch."
          },
          "confirm": {
            "default": false,
            "type": "boolean",
            "description": "False (default) returns a preview without fetching. True performs the fetch."
          },
          "invocation_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required when confirm=true. Must match the token returned by the preview call."
          },
          "limit": {
            "default": 20,
            "minimum": 1,
            "type": "integer",
            "description": "Entities per page (min 1, default 20)."
          },
          "page": {
            "default": 1,
            "minimum": 1,
            "type": "integer",
            "description": "1-based page number over the fetched entities."
          }
        },
        "required": [
          "names"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "_meta": {
        "fastmcp": {
          "tags": []
        }
      }
